      ],
      "observation": "The material discussed includes a striking opposition between a fair or white supernatural woman and a black, blood-associated raven, forming part of a broader black/white/red colour configuration.",
      "status": "secondary",
      "notes": "This should be tied to the exact textual passage and scholarly source before being treated as a securely attested recurring motif.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-white-other-hypothesis",
      "sourceId": "tradition-norse",
      "entityIds": [
        "motif-white-other",
        "concept-whiteness"
      ],
      "relationIds": [
        "white-other-expresses-whiteness"
      ],
      "observation": "A working hypothesis is that extreme bodily whiteness may function as a marker of supernatural, exceptional or otherwise other status in some Germanic literary traditions.",
      "status": "interpretive",
      "notes": "This is a research hypothesis, not an established generalisation.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

        {
      "id": "evidence-noah",
      "sourceId": "source-first-enoch",
      "entityIds": [
        "figure-noah",
        "concept-extreme-bodily-whiteness",
        "concept-luminous-eyes"
      ],
      "relationIds": [
        "noah-extreme-whiteness",
        "noah-luminous-eyes",
        "noah-first-enoch"
      ],
      "observation": "The birth narrative of Noah in 1 Enoch describes his body as white as snow, his hair as white as wool, and his eyes as rays of the sun. The description presents extreme bodily whiteness together with unusual luminosity as an anomalous physiognomic complex.",
      "status": "primary",
      "notes": "Important early evidence for the combination of extreme whiteness, white hair and luminous eyes. The relationship to later Christian apocalyptic imagery should remain a historical question rather than an assumed genealogy.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-ancient-days",
      "sourceId": "source-daniel",
      "entityIds": [
        "figure-ancient-of-days",
        "concept-extreme-bodily-whiteness"
      ],
      "relationIds": [
        "ancient-days-whiteness",
        "ancient-days-daniel"
      ],
      "observation": "Daniel 7 describes the Ancient of Days with clothing white as snow and hair like pure wool.",
      "status": "primary",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-man-linen",
