      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-son-man",
      "sourceId": "source-revelation",
      "entityIds": [
        "figure-son-of-man",
        "concept-extreme-bodily-whiteness",
        "concept-luminous-eyes"
      ],
      "relationIds": [
        "son-man-whiteness",
        "son-man-luminous-eyes",
        "son-man-revelation"
      ],
      "observation": "Revelation 1 describes the Son of Man with hair white as wool and snow, eyes like a flame of fire, and a face shining like the sun in full strength.",
      "status": "primary",
      "notes": "This is a particularly important articulation of the white-hair/fiery-eye/luminosity complex.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-charicleia",
      "sourceId": "source-aethiopica",
      "entityIds": [
        "figure-charicleia",
        "concept-extreme-bodily-whiteness"
      ],
      "relationIds": [
        "charicleia-whiteness",
        "charicleia-aethiopica"
      ],
      "observation": "Charicleia is born exceptionally white to Ethiopian parents, making anomalous whiteness a conspicuous feature requiring explanation within the narrative.",
      "status": "primary",
      "notes": "Useful for the history of anomalous whiteness independently of the later medical category of albinism.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-pliny-albanian",
      "sourceId": "source-pliny-natural-history",
      "entityIds": [
        "concept-extreme-bodily-whiteness",
        "concept-luminous-eyes"
      ],
      "relationIds": [],
      "observation": "Pliny, citing Isigonus of Nicaea, reports people born with greyish eyes who become white-haired from childhood and who see better at night than during the day.",
      "status": "primary",
      "notes": "The description has been interpreted by modern scholars as a possible ancient description of albinism. The identification should remain explicitly tentative.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
      "id": "evidence-heimdallr",
      "sourceId": "source-thrymskvida",
      "entityIds": [
