      ],
      "relationIds": [
        "heimdallr-whiteness",
        "heimdallr-thrymskvida"
      ],
      "observation": "Heimdallr is described as hvítastr ása, conventionally 'whitest' or 'fairest of the Æsir'.",
      "status": "primary",
      "notes": "The superlative is especially significant because whiteness is attached to a liminal supernatural figure rather than merely functioning as a generic colour adjective.",
      "createdAt": "2026-08-18T00:00:00Z"
    },

    {
