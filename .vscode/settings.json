{
	"python.defaultInterpreterPath": ".\\python\\.venv\\Scripts\\python.exe",
	"python.pythonPath": ".\\python\\.venv\\Scripts\\python.exe",
	"python.linting.enabled": true,
	"python.linting.flake8Enabled": true,
	"python.linting.flake8Args": [
		"--config",
		"${workspaceFolder}/python/.flake8"
	],
	"editor.renderWhitespace": "all",
	"editor.renderControlCharacters": true,
	"editor.renderFinalNewline": "on",
	"files.trimTrailingWhitespace": true,

	"biome.configurationPath": "./gui/research/biome.json",
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.biome": "explicit"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},

	"python-envs.defaultEnvManager": "UV",
	"python-envs.defaultPackageManager": "ms-python.python:conda",
	"cSpell.words": ["Bpedia", "ECCO", "EEBO", "FAISS", "SBERT"],
	"json.schemaDownload.trustedDomains": {
		"https://biomejs.dev": true
	}
}
